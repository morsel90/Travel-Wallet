#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# خطاف ما قبل الدفع — البوابة المحلية قبل وصول أي شيء إلى main.
#
# لماذا يوجد: تاريخ هذا المستودع لا يحتوي ولا merge commit واحداً — كل شيء
# يُدفع مباشرةً إلى main. أي أن مُشغِّل `pull_request:` في .github/workflows/ci.yml
# لم يُفعَّل قط، والمُشغِّل العامل الوحيد هو `push:`. والفرق حاسم: الـ CI على PR
# بوّابة تمنع، وعلى push تقرير يصل *بعد* وقوع الأمر.
#
# هكذا وصل c51e9f8 إلى main وهو يكسر ثلاثة اختبارات في useMyTrips.test.ts: أضاف
# حقل status إلى MyTrip ولم يحدّث المقارنات. بقيت المجموعة حمراء يومين.
#
# ما لا يُشغَّل هنا عمداً: test:rules و test:e2e — كلاهما يحتاج Java ومحاكيات
# ويستغرق دقائق، وخطاف بهذا البطء يُتجاوَز بـ --no-verify فيصير عديم القيمة.
# تبقيان في CI. المقصود هنا هو أسرع مجموعة تمسك أكثر الأخطاء شيوعاً.
#
# للتجاوز عند الضرورة:  git push --no-verify
# ─────────────────────────────────────────────────────────────────────────────

set -e

printf '\n\033[1m▸ فحص ما قبل الدفع (lint → typecheck → test)\033[0m\n\n'

run_step() {
  label="$1"
  shift
  printf '  \033[2m…\033[0m %s\n' "$label"
  if ! "$@" >/tmp/prepush.log 2>&1; then
    printf '\n  \033[31m✗ فشل: %s\033[0m\n\n' "$label"
    tail -40 /tmp/prepush.log
    printf '\n\033[31mالدفع متوقّف.\033[0m أصلح ما سبق، أو تجاوَز بـ \033[1mgit push --no-verify\033[0m إن كنت متأكداً.\n\n'
    exit 1
  fi
  printf '  \033[32m✓\033[0m %s\n' "$label"
}

run_step 'ESLint'    npm run lint
run_step 'TypeScript' npm run typecheck
run_step 'الاختبارات الوحدوية' npm test

printf '\n\033[32m✓ كل الفحوص خضراء — يُتابَع الدفع.\033[0m\n\n'
