# التبعيات
node_modules

# مخرجات البناء
dist
dist-ssr

# النشر
.vercel

# متغيرات البيئة (لا تُرفع أبداً)
.env
.env.*
!.env.example

# مفاتيح حساب الخدمة (Firebase Admin) — سرّية ولا تُرفع أبداً
# 🆕 النمط لا الاسم الواحد: مفاتيح البيئات الأخرى (serviceAccountKey.staging.json
# وغيرها) كانت ستُرفع لأن القاعدة السابقة كانت تطابق الاسم الافتراضي وحده.
serviceAccountKey*.json

# ملفات النظام والمحرر
.DS_Store
*.local
# 🆕 استثناء: functions/.secret.local ليس سرّاً حقيقياً — قيمة وهمية غير
# صالحة عمداً (Sentry.init تتجاهلها بصمت، انظر docs/DECISIONS.md)، وجودها
# يمنع محاكي Cloud Functions من محاولة الاتصال الشبكي الحقيقي بـ Secret
# Manager لكل استدعاء دالة أثناء اختبارات e2e — بلا هذا الملف كانت تلك
# المحاولات (تفشل دائماً ضد مشروع demo وهمي) تُبطئ الاختبارات وتسبّب تذبذباً
# حقيقياً في المهلات الزمنية الحسّاسة. يجب أن يبقى مُتتبَّعاً لتعمل CI بلا تذبذب.
!functions/.secret.local
*.log
.vscode/*
!.vscode/extensions.json
.idea

*storybook.log
storybook-static
.env*

# ملفات محلية لأدوات Firebase CLI (محاكيات Firestore/Auth/Functions للاختبارات)
.firebase
firebase-debug.log
firestore-debug.log
ui-debug.log

# ملف رمز خروج المحاكيات (scripts/run-with-emulators.mjs) — يُحذف تلقائياً،
# ويبقى فقط إن انهارت العملية فجأة
.emulator-exit-*

# ملفات مؤقتة تُنشئها أنظمة ملفات FUSE عند حذف ملف ما زال مفتوحاً
.fuse_hidden*

# مخرجات Playwright (اختبارات E2E)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# 🆕 أداة graphify المحلية — رسم بياني للمعرفة يُولَّد من الكود، وذاكرة
# تخزين مؤقت له (AST/دلالية). مُنشأ محلياً بـ `graphify update .`، وليس
# مصدراً — نفس منطق dist/ وnode_modules/. إعادة توليده أرخص من مزامنته.
/graphify-out/

# إعدادات Claude Code/Cowork المحلية (مفاتيح جلسات، أقفال مهام مجدولة) — خاصة
# بالجهاز لا بالمشروع.
/.claude/

# نسخ احتياطية ينتجها scripts/set-school-calendar.mjs قبل كل كتابة
itinerary-backup-*.json
